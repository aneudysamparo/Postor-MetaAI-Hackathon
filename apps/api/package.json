{
  "name": "@postor/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/brain-regression.test.mjs test/boot.test.mjs test/analyst.test.mjs test/workflow-state.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:sqlite:prepare": "node prisma/derive-sqlite-schema.mjs",
    "db:push:sqlite": "npm run prisma:sqlite:prepare && prisma db push --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@postor/contracts": "0.1.0",
    "@prisma/client": "^6.19.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
