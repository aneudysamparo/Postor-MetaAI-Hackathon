# Copy to .env and fill in. Never commit the real key.
META_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL_DEFAULT=muse-spark-1.3
# Model routing (optional): the Bid Reviewer audits on a different Meta model
# (default muse-wonder-1.0, max-effort reasoning); SAM model for regions.
META_MODEL_REVIEWER=
META_MODEL_SAM=
DATABASE_URL=postgresql://postor:postor@127.0.0.1:5432/postor?schema=public
PORT=3000

# Cost estimate for the Agent Trace (USD per million tokens). When unset the
# trace uses placeholder rates and labels them as such. Not billing data.
META_COST_INPUT_USD_PER_MTOK=
META_COST_OUTPUT_USD_PER_MTOK=

# Voice answers to [PENDING] items (optional override of the ASR model).
META_MODEL_VOICE=

# Document guard. Default: a deterministic screen + Muse Spark judge on the
# Meta Model API (no extra setup). Set POSTOR_GUARD_URL to use Meta Llama
# Prompt Guard 2 (86M) self-hosted on Modal instead (deploy/modal/
# prompt_guard.py). POSTOR_GUARD=off skips the step (reported as skipped).
POSTOR_GUARD=
POSTOR_GUARD_URL=
POSTOR_GUARD_TOKEN=
POSTOR_GUARD_THRESHOLD=
